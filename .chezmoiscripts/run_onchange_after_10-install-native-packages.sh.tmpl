#!/usr/bin/env bash

set -euo pipefail

# package inventory: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

{{ if or (eq .profile "desktop") (eq .profile "enterprise") -}}
if command -v brew >/dev/null 2>&1; then
  brew_bin="$(command -v brew)"
else
  brew_bin="/opt/homebrew/bin/brew"
fi
eval "$("$brew_bin" shellenv)"
brew bundle --file="{{ .chezmoi.homeDir }}/.config/brew/Brewfile"
{{ if eq .profile "enterprise" -}}
for cask in {{ range .packages.macos.enterprise_optional_casks }}{{ printf "%q " . }}{{ end }}; do
  brew install --cask "$cask" || printf 'Optional enterprise cask failed: %s\n' "$cask" >&2
done
{{ end -}}
{{ else if eq .profile "server" -}}
sudo install -d -m 0755 /etc/yum.repos.d
sudo tee /etc/yum.repos.d/rex.repo >/dev/null <<'EOF'
[rex]
name=Rex ({{ .packages.rex.channel }})
baseurl=https://pkgs.superlogical.com/rex/rpm/{{ .packages.rex.channel }}/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://pkgs.superlogical.com/rex/keys/rex.asc
EOF
packages=(
{{- range .packages.amazon_linux }}
  {{ . | quote }}
{{- end }}
)
sudo dnf install -y "${packages[@]}"
{{ else -}}
printf '%s\n' 'Container profile: native packages are owned by the image.'
{{ end -}}
