#!/usr/bin/env bash

set -euo pipefail

# mise tools: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# npm tools: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if [ -f "$HOME/.config/ssl/ca-bundle.pem" ]; then
  export SSL_CERT_FILE="$HOME/.config/ssl/ca-bundle.pem"
fi
if [ -f "$HOME/.config/ssl/corporate-ca.pem" ]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.config/ssl/corporate-ca.pem"
fi

if command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
elif [ -x "$HOME/.local/bin/mise" ]; then
  mise_bin="$HOME/.local/bin/mise"
else
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  mise_version="2026.8.6"
  curl -fsSL "https://mise.jdx.dev/v${mise_version}/install.sh" -o "$installer"
  expected="18ec854e24388880277a84e73434114eb80cdf2066afcf3671fed2682cb1ea4a"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$installer" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$installer" | awk '{print $1}')"
  fi
  [ "$actual" = "$expected" ] || { printf '%s\n' 'mise installer checksum mismatch' >&2; exit 1; }
  MISE_VERSION="v${mise_version}" MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh "$installer"
  mise_bin="$HOME/.local/bin/mise"
fi

"$mise_bin" trust "$HOME/.config/mise"
"$mise_bin" install --yes

npm_packages=(
{{- range $package, $version := .packages.npm }}
{{- if or (ne $.profile "server") (ne $package "tree-sitter-cli") }}
  {{ printf "%s@%s" $package $version | quote }}
{{- end }}
{{- end }}
)

npm_registry="$(npm config get registry)"
npm uninstall --global --prefix "$HOME/.local" @opencode-ai/cli opencode-ai
npm install --global --prefix "$HOME/.local" \
  --registry "$npm_registry" \
  --allow-scripts=@opencode/cli,node-pty,tree-sitter-cli \
  --ignore-scripts=false "${npm_packages[@]}"
