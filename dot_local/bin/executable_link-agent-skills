#!/usr/bin/env bash

# Install the personal skills repository for every supported agent at the
# global user scope. The Skills CLI manages agent-specific destinations and
# preserves its own installation metadata.
set -euo pipefail

repository="josephhaaga/skills"

if ! command -v npx >/dev/null 2>&1; then
  printf 'link-agent-skills requires npx (included with Node.js).\n' >&2
  exit 1
fi

exec npx --yes skills add "$repository" --global --all
