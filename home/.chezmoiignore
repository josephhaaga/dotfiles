# Credential stores and session logs written by pi and omp at runtime. Listed so
# a stray `chezmoi add ~/.pi` or `~/.omp` cannot pull API keys into the repo.
.pi/agent/auth.json
.pi/agent/sessions
.pi/agent/trust.json
.omp/agent/agent.db*
.omp/agent/sessions

{{- if not .work }}
# Without an age configuration, chezmoi treats encrypted sources as .age targets.
.config/opencode/opencode.personal.json.age
.config/zsh/.secrets.age
{{- end }}
