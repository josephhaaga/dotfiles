#!/usr/bin/env bash

# Print the Chrome extension inventory whenever the desktop source is applied.
# Opening Chrome Web Store pages is always an explicit manual action.
set -euo pipefail

{{ if eq .profile "desktop" -}}
profile_dir="$HOME/Library/Application Support/Google/Chrome/Default"
if [ ! -d "$profile_dir" ]; then
  printf '%s\n' 'Chrome Default profile not created yet; skipping extension audit.'
  exit 0
fi

"$HOME/.local/bin/chrome-extensions"
{{ else -}}
printf '%s\n' 'Chrome extension synchronization is available on the desktop profile only.'
{{ end -}}
