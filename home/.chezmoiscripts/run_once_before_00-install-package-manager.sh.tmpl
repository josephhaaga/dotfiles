#!/usr/bin/env bash

set -euo pipefail

{{ if eq .profile "desktop" -}}
if ! command -v brew >/dev/null 2>&1; then
  printf '%s\n' 'Installing Homebrew...'
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl -fsSL \
    https://raw.githubusercontent.com/Homebrew/install/cced90146ea6d3057c03a636b668fef177415eb3/install.sh \
    -o "$installer"
  /bin/bash "$installer"
fi
{{ else if eq .profile "enterprise" -}}
command -v brew >/dev/null 2>&1 || {
  printf '%s\n' 'Enterprise profile requires an MDM-approved Homebrew installation.' >&2
  exit 1
}
{{ else -}}
mkdir -p "$HOME/.local/bin"
{{ end -}}
