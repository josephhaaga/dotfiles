#!/bin/bash
set -euo pipefail

# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# Re-run automatically whenever .chezmoidata/packages.yaml changes.
# The rendered Brewfile itself lives at ~/.config/brew/Brewfile (see
# dot_config/brew/Brewfile.tmpl) so `brew bundle dump`/`brew bundle` also
# work standalone, matching the `brew` shell wrapper in dot_zshrc.

eval "$(/opt/homebrew/bin/brew shellenv)"
echo "Installing Homebrew packages from packages.yaml..."
brew bundle --file="{{ .chezmoi.homeDir }}/.config/brew/Brewfile"
