#!/usr/bin/env bash

set -euo pipefail

# OpenChamber is installed from its official package. It connects to the
# separately managed OpenCode V2 service; it does not bundle or wrap OpenCode.
# OpenChamber package: {{ index .packages.npm_server "@openchamber/web" }}

{{ if eq .profile "server" -}}
# Remove the retired system-wide preview service. The user services below are
# source-managed so Node upgrades cannot leave a generated unit pointing at an
# obsolete mise installation.
legacy_unit="/etc/systemd/system/openchamber.service"
if [ -f "$legacy_unit" ]; then
  sudo systemctl disable --now openchamber.service || true
  sudo rm -f "$legacy_unit"
  sudo systemctl daemon-reload
fi

# OpenCode requires a server password even when bound to loopback. Keep the
# shared value as VM-local runtime state: it is neither rendered nor committed.
runtime_env="$HOME/.config/opencode/server.env"
if [ ! -s "$runtime_env" ]; then
  umask 077
  mkdir -p "${runtime_env%/*}"
  password="$(openssl rand -base64 48 | tr -d '\n')"
  printf 'OPENCODE_SERVER_PASSWORD=%s\n' "$password" > "$runtime_env"
fi
chmod 600 "$runtime_env"

systemctl --user daemon-reload
systemctl --user enable opencode.service openchamber.service
systemctl --user restart opencode.service
systemctl --user restart openchamber.service
{{ else -}}
printf '%s\n' 'OpenChamber is only configured on the server profile.'
{{ end -}}
