{{- range .packages.taps }}
{{- if eq . "josephhaaga/dotfiles" }}
tap "josephhaaga/dotfiles", {{ printf "file://%s" $.dotfilesRepo | quote }}, trusted: true
{{- else }}
tap {{ . | quote }}
{{- end }}
{{- end }}

{{ range .packages.brews }}
brew {{ . | quote }}
{{- end }}

{{ range .packages.casks }}
{{- if eq . "josephhaaga/dotfiles/opentypeless" }}
cask "josephhaaga/dotfiles/opentypeless", postinstall: "/usr/bin/xattr -cr /Applications/OpenTypeless.app"
{{- else }}
cask {{ . | quote }}
{{- end }}
{{- end }}

{{- if .work }}

# --- work overlay ---
{{- range .packages.work_casks }}
cask {{ . | quote }}
{{- end }}
{{- end }}
