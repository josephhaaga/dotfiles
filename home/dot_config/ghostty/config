font-family = JetBrains Mono
font-size = 16
theme = tokyonight-storm
# theme = 0x96f
# If you want to avoid text that is difficult to read, a value of 3 or higher is a good value. The higher the value, the more likely that text will become black or white.
minimum-contrast = 3.0

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true


background-opacity = 0.94

## Leader-key split bindings

## 1. Clear the prefix
keybind = ctrl+b=unbind

## 2. Visual Splits (Vertical and Horizontal)
## - for a vertical line separating two panes (Vertical Split)
## | for a horizontal line separating two panes (Horizontal Split)
keybind = ctrl+b>shift+backslash=new_split:right
keybind = ctrl+b>minus=new_split:down

## 3. Quick Navigation (Vim-style)
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:bottom
keybind = ctrl+b>k=goto_split:top
keybind = ctrl+b>l=goto_split:right

## 4. Utilities
keybind = ctrl+b>z=toggle_split_zoom
keybind = ctrl+b>ctrl+b=text:\x02
keybind = ctrl+b>t=toggle_quick_terminal
keybind = global:cmd+backquote=toggle_quick_terminal
keybind = ctrl+b>shift+;=toggle_command_palette

## More ideas from `ghostty +list_actions`
##
##
## Use `toggle_background_opacity`
##
## ```
## toggle_background_opacity:
##   Toggle the window background opacity between transparent and opaque.
##
##   This does nothing when `background-opacity` is set to 1 or above.
##
##   When `background-opacity` is less than 1, this action will either make
##   the window transparent or not depending on its current transparency state.
##
##   Only implemented on macOS.
## ```
##
##
## Use `jump_to_prompt` to align with Opencode's `/timeline` behavior
##
## ```
## jump_to_prompt:
##  Jump the viewport forward or back by the given number of prompts.
##
##  Requires shell integration.
##
##  Positive values scroll downwards, and negative values scroll upwards.
## ```
##
##
## Use `activate_key_table` to align "profiles" across skhd/yabai, Ghostty, Neovim etc.
##
## ```
## activate_key_table:
##   Activate a named key table (see `keybind` configuration documentation).
##   The named key table will remain active until `deactivate_key_table`
##   is called. If you want a one-shot key table activation, use the
##   `activate_key_table_once` action instead.
##
##   If the named key table does not exist, this action has no effect
##   and performable will report false.
##
##   If the named key table is already the currently active key table,
##   this action has no effect and performable will report false.
## ```
