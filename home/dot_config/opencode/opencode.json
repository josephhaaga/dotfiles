{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@plannotator/opencode@latest",
    "./local-plugins/hub.ts",
    [
      "opencode-agent-profiler",
      {
        "traceLog": "/tmp/ap-trace.log",
        "captureContent": true,
        "captureHeaders": true,
        "maxAttrChars": 200000,
        "hideInputs": false,
        "hideOutputs": false,
        "hideInputMessages": false,
        "hideOutputMessages": false
      }
    ]
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browserUrl=http://127.0.0.1:9222"]
    },
    "agent-mcp": {
      "type": "remote",
      "url": "https://agent-mcp-production-db5b.up.railway.app/mcp",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "seekstone"],
      "environment": {
        "SEEKSTONE_VAULT": "/Users/josephhaaga/Documents/obsidian-vault"
      },
      "enabled": true
    }
  },
  "agent": {
    "title": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "plan": {
      "model": "github-copilot/claude-opus-4.8"
    },
    "ask": {
      "mode": "primary",
      "description": "Answers questions with repository and web research without modifying the workspace.",
      "color": "info",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": {
          "*": "deny",
          "/tmp/opencode-ask/**": "allow"
        },
        "bash": {
          "*": "deny",
          "mkdir -p /tmp/opencode-ask": "allow"
        },
        "external_directory": {
          "*": "deny",
          "/tmp/opencode-ask": "allow",
          "/tmp/opencode-ask/**": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow"
      },
      "prompt": "Answer questions through research and analysis. Do not modify the workspace or any user files. You may write only under /tmp/opencode-ask/ when retaining web-fetch results or calculation notes. The only permitted shell command is mkdir -p /tmp/opencode-ask to create that directory. Do not run Python, use other shell commands, delegate tasks, or invoke tools other than the explicitly permitted read and web-research tools."
    }
  }
}
