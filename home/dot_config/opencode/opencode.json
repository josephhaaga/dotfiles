{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode@4.19.4",
    "@plannotator/opencode@latest",
    "./local-plugins/hub.ts",
    [
      "opencode-agent-profiler",
      {
        "traceLog": "/tmp/ap-trace.log",
        "captureContent": false,
        "captureHeaders": false,
        "maxAttrChars": 4000,
        "hideInputs": true,
        "hideOutputs": true,
        "hideInputMessages": true,
        "hideOutputMessages": true
      }
    ]
  ],
  "mcp": {
    "agent-mcp": {
      "type": "remote",
      "url": "https://agent-mcp-production-db5b.up.railway.app/mcp",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "seekstone"],
      "environment": {
        "SEEKSTONE_VAULT": "/Users/josephhaaga/Documents/obsidian-vault"
      },
      "enabled": true
    }
  },
  "tools": {
    "gitnexus_api_impact": false
  },
  "permission": {
    "task": {
      "build": "deny",
      "plan": "deny"
    }
  },
  "agent": {
    "ask": {
      "mode": "primary",
      "description": "Answers questions with repository and web research without modifying the workspace.",
      "color": "info",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": {
          "*": "deny",
          "/tmp/opencode-ask/**": "allow"
        },
        "bash": {
          "*": "deny",
          "mkdir -p /tmp/opencode-ask": "allow"
        },
        "external_directory": {
          "*": "deny",
          "/tmp/opencode-ask": "allow",
          "/tmp/opencode-ask/**": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "agent-mcp_*": "allow"
      },
      "prompt": "Answer questions through research and analysis. Do not modify the workspace or any user files. You may write only under /tmp/opencode-ask/ when retaining web-fetch results or calculation notes. The only permitted shell command is mkdir -p /tmp/opencode-ask to create that directory. You may use Agent MCP only to discover and call read-only lookup tools; do not use it to write, delete, send, or otherwise modify external data. Do not run Python, use other shell commands, delegate tasks, or invoke tools other than the explicitly permitted read and research tools."
    }
  }
}
