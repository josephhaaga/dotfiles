{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "share": "manual",
  "model": "openai/gpt-5.6-terra-fast",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-terra-fast"
    }
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      {{- if eq .profile "enterprise" }}
      { "action": "provider.use", "resource": "github-copilot", "effect": "allow" }
      {{- else }}
      { "action": "provider.use", "resource": "openrouter", "effect": "allow" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" },
      { "action": "provider.use", "resource": "anthropic", "effect": "allow" }
      {{- end }}
    ]
  },
  "plugins": [
    {{- if eq .profile "enterprise" }}
    "{{ .chezmoi.homeDir }}/.local/lib/node_modules/@plannotator/opencode/dist/server.js"
    {{- else }}
    "@plannotator/opencode@{{ index .packages.npm "@plannotator/opencode" }}"
    {{- end }}
  ],
{{- if eq .profile "enterprise" }}
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "--offline",
          "-y",
          "@playwright/mcp@0.0.79",
          "--executable-path",
          "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        ],
        "disabled": false
      },
      "outlook-teams": {
        "type": "local",
        "command": [
          "node",
          "{{ .chezmoi.homeDir }}/Documents/FIS/fis-engineering-context/joe-data/outlook-teams-mcp/dist/index.js",
          "--profile-dir",
          "{{ .chezmoi.homeDir }}/.outlook-teams-mcp/chrome-profile"
        ],
        "disabled": false
      }
    }
  },
{{- else }}
  "mcp": {
    "servers": {
      {{- if eq .profile "desktop" }}
      "mempalace": {
        "type": "local",
        "command": ["mempalace-mcp"],
        "disabled": false
      },
      {{- end }}
      "agent-mcp": {
        "type": "remote",
        "url": "https://agent-mcp-production-db5b.up.railway.app/mcp",
        "disabled": false{{ if eq .profile "server" }},
        "oauth": {
          "redirect_uri": "https://josephhaaga.sh.tribe.ai/mcp/oauth/callback?server=agent-mcp"
        }{{ end }}
      },
      "granola": {
        "type": "remote",
        "url": "https://mcp.granola.ai/mcp",
        "disabled": false
      }
    }
  },
{{- end }}
  "permissions": [
    { "action": "subagent", "resource": "build", "effect": "deny" },
    { "action": "subagent", "resource": "plan", "effect": "deny" }
  ]
}
