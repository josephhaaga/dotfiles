#!/usr/bin/env bash

# Check for upgrades once per day rather than on every interactive shell.
set -euo pipefail

command -v brew >/dev/null 2>&1 || exit 0

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/brew-session-notice"
stamp_file="$cache_dir/last-checked"
today="$(date +%F)"

if [ -r "$stamp_file" ] && [ "$(<"$stamp_file")" = "$today" ]; then
    exit 0
fi

mkdir -p "$cache_dir"
printf '%s\n' "$today" > "$stamp_file"

command brew update --quiet >/dev/null 2>&1 || true
outdated="$(command brew outdated 2>/dev/null || true)"
[ -z "$outdated" ] && exit 0

count="$(printf '%s\n' "$outdated" | wc -l | tr -d ' ')"
faint='\033[2m'
reset='\033[0m'

printf '%bHomebrew: %s upgrade%s available\n' "$faint" "$count" "$( [ "$count" -eq 1 ] || printf 's')"
printf '%b%s%b\n' "$faint" "$outdated" "$reset"
printf '%bRun `dotfiles upgrade` to apply them.%b\n' "$faint" "$reset"
