#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  install)
    chezmoi apply
    ;;
  update|upgrade)
    chezmoi apply
    command brew update
    command brew upgrade
    command brew bundle check --file="$HOME/.config/brew/Brewfile"
    ;;
  "")
    exec nvim -c 'Neotree' -s - "$(chezmoi source-path)"
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage: dotfiles [install|upgrade]

  install Apply the declared chezmoi configuration.
  upgrade Apply declared configuration, then update and upgrade Homebrew packages.
  update  Alias for upgrade.
EOF
    ;;
  *)
    printf 'Unknown dotfiles command: %s\n' "$1" >&2
    exit 2
    ;;
esac
