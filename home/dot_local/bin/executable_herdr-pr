#!/usr/bin/env bash

# Create a Herdr worktree, then hand a task to OpenCode through to a draft PR.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: herdr-pr [--branch NAME] [--cwd PATH] [TASK]

Create a Herdr worktree and launch OpenCode to implement TASK through a draft
GitHub pull request. When TASK is omitted, an interactive prompt collects it.
EOF
}

branch=""
cwd="${PWD}"
task=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --branch)
      [ "$#" -ge 2 ] || { printf '%s\n' '--branch requires a value' >&2; exit 2; }
      branch="$2"
      shift 2
      ;;
    --cwd)
      [ "$#" -ge 2 ] || { printf '%s\n' '--cwd requires a value' >&2; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      task="$*"
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      task="$*"
      break
      ;;
  esac
done

for command in git gh gum herdr opencode jq; do
  command -v "$command" >/dev/null 2>&1 || {
    printf 'Required command is unavailable: %s\n' "$command" >&2
    exit 1
  }
done

if [ "${HERDR_ENV:-}" != "1" ] && [ -z "${HERDR_SOCKET_PATH:-}" ]; then
  printf '%s\n' 'Run herdr-pr from a Herdr-managed pane or Herdr popup.' >&2
  exit 1
fi

[ -n "$cwd" ] || cwd="$PWD"
repo_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'Not a Git repository: %s\n' "$cwd" >&2
  exit 1
}

if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
  printf '%s\n' 'Refusing to create a worktree from a dirty checkout.' >&2
  exit 1
fi

if [ -z "$task" ]; then
  task="$(gum input --prompt 'Task: ' --placeholder 'Describe the feature or bug fix')"
fi

if [ -z "$task" ]; then
  printf '%s\n' 'A task description is required.' >&2
  exit 2
fi

base="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
base="${base#origin/}"
if [ -z "$base" ]; then
  base="$(git -C "$repo_root" branch --show-current)"
fi

if [ -z "$base" ]; then
  printf '%s\n' 'Cannot determine a base branch from this detached checkout.' >&2
  exit 1
fi

if [ -z "$branch" ]; then
  naming_prompt=$(cat <<EOF
Read this repository's AGENTS.md and related contribution guidance if present.
Propose a branch name for this task: $task
Use the repository's documented branch convention when one exists. Otherwise use
a concise conventional prefix such as feat/, fix/, chore/, or refactor/.
Reply with exactly the branch name, with no Markdown, explanation, or quotes.
EOF
)
  branch="$(OPENCODE_CONFIG="$HOME/.config/opencode/opencode.work.json" command opencode run --auto --agent build "$naming_prompt" | tr -d '\r')"
fi

if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
  printf 'OpenCode did not return a valid branch name: %s\n' "$branch" >&2
  exit 1
fi

if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch" || \
  git -C "$repo_root" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  printf 'Branch already exists: %s\n' "$branch" >&2
  exit 1
fi

created="$(herdr worktree create --cwd "$repo_root" --branch "$branch" --base "$base" --label "$branch" --focus)"
worktree="$(printf '%s\n' "$created" | jq -er '.result.workspace.cwd')"
pane_id="$(printf '%s\n' "$created" | jq -er '.result.root_pane.pane_id')"

agent_prompt=$(cat <<EOF
Implement this task in the current worktree: $task

This branch is $branch and its base is $base. Work autonomously through a draft
GitHub PR: read AGENTS.md and repository guidance; implement the requested
change; run the relevant checks; inspect your final diff; commit only your
intended changes with a conventional message; push the branch; and create a
draft PR with gh pr create --draft, honoring any repository PR template or
conventions. Include a clear PR title and summary.

After the PR is created, call herdr notification show with a title such as
"Draft PR ready" and the PR URL in the notification body, then report that URL
in your final response. If any required step fails or needs a decision, stop,
report the concrete blocker, and do not claim the PR was created.
EOF
)

command_text="cd $(printf '%q' "$worktree") && OPENCODE_PROFILE=work opencode --auto --prompt $(printf '%q' "$agent_prompt")"
herdr pane run "$pane_id" "$command_text"

printf 'OpenCode started in %s on %s.\n' "$worktree" "$branch"
