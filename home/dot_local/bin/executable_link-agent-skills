#!/usr/bin/env bash

# Make the personal skills checkout available to every agent that supports the
# Agent Skills user location (~/.agents/skills). This command never changes the
# checkout or replaces an existing directory/link.
set -euo pipefail

source_dir="${PERSONAL_SKILLS_DIR:-$HOME/Documents/skills}/skills"
destination="$HOME/.agents/skills"

if ! source_dir="$(cd -P "$source_dir" 2>/dev/null && pwd)"; then
  printf 'Personal skills source is unavailable: %s\n' \
    "${PERSONAL_SKILLS_DIR:-$HOME/Documents/skills}/skills" >&2
  printf 'Clone josephhaaga/skills there, or set PERSONAL_SKILLS_DIR.\n' >&2
  exit 1
fi

if ! find "$source_dir" -type f -name SKILL.md -print -quit | grep -q .; then
  printf 'Personal skills source has no SKILL.md files: %s\n' "$source_dir" >&2
  exit 1
fi

mkdir -p "$(dirname "$destination")"

if [[ -L "$destination" ]]; then
  if ! current_target="$(cd -P "$destination" 2>/dev/null && pwd)"; then
    printf 'Refusing to replace dangling skills symlink: %s\n' "$destination" >&2
    exit 1
  fi
  if [[ "$current_target" == "$source_dir" ]]; then
    printf 'Agent skills are already linked: %s -> %s\n' "$destination" "$source_dir"
    exit 0
  fi
  printf 'Refusing to replace existing skills symlink: %s -> %s\n' \
    "$destination" "$current_target" >&2
  exit 1
fi

if [[ -e "$destination" ]]; then
  printf 'Refusing to replace existing path: %s\n' "$destination" >&2
  exit 1
fi

ln -s "$source_dir" "$destination"
printf 'Linked agent skills: %s -> %s\n' "$destination" "$source_dir"
