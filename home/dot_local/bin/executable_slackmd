#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: slackmd <slack-thread-url> [-o DIR]\n' >&2
  exit 1
}

[ "$#" -ge 1 ] || usage
url="$1"
shift
output_dir=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o)
      [ "$#" -ge 2 ] || usage
      output_dir="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

formatter="$HOME/.local/lib/dotfiles/format_slackdump_as_md.py"
if [ -n "$output_dir" ]; then
  mkdir -p "$output_dir"
  gh slackdump -u "$url" | uv run --with pycryptodome "$formatter" -o "$output_dir"
else
  gh slackdump -u "$url" | uv run "$formatter"
fi
