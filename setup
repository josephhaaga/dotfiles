#!/usr/bin/env bash

set -euo pipefail
umask 022

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_dir="$repo_dir/v2/home"

if [ ! -d "$source_dir" ]; then
  printf 'v2 chezmoi source not found: %s\n' "$source_dir" >&2
  exit 1
fi

if ! command -v chezmoi >/dev/null 2>&1; then
  chezmoi_version="2.72.0"
  bin_dir="$HOME/.local/bin"
  download="$(mktemp)"
  tmp_dir="$(mktemp -d)"
  trap 'rm -f "$download"; rm -rf "$tmp_dir"' EXIT
  mkdir -p "$bin_dir"
  case "$(uname -s):$(uname -m)" in
    Darwin:arm64) asset="chezmoi-darwin-arm64"; expected="c576ca81339099f2d0ccc6ce2c6c93d7c4ff5ca1f0bf63e4a0c478a306c6d989"; archive=false ;;
    Darwin:x86_64) asset="chezmoi-darwin-amd64"; expected="dca12789c5d9bda59367abb1f8689fe6d318dfff425eff0bf7b63a37b3dd68e1"; archive=false ;;
    Linux:aarch64|Linux:arm64) asset="chezmoi_2.72.0_linux_arm64.tar.gz"; expected="e79a27621256390f03166d3965e6a1946f983a096c4d90f02c43d2aa5b563728"; archive=true ;;
    Linux:x86_64) asset="chezmoi-linux-amd64"; expected="ba563f716d5c00a2e91d4aeb199b417c6b219db2896f890fd422fc72610b2d90"; archive=false ;;
    *) printf 'unsupported platform for chezmoi bootstrap: %s:%s\n' "$(uname -s)" "$(uname -m)" >&2; exit 1 ;;
  esac
  curl -fsSL "https://github.com/twpayne/chezmoi/releases/download/v${chezmoi_version}/${asset}" -o "$download"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$download" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$download" | awk '{print $1}')"
  fi
  [ "$actual" = "$expected" ] || { printf '%s\n' 'chezmoi binary checksum mismatch' >&2; exit 1; }
  if [ "$archive" = true ]; then
    tar -xzf "$download" -C "$tmp_dir"
    binary="$tmp_dir/chezmoi"
  else
    binary="$download"
  fi
  install -m 0755 "$binary" "$bin_dir/chezmoi"
  export PATH="$bin_dir:$PATH"
fi

exec chezmoi init --apply --force --source "$source_dir"
