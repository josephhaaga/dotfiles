#!/usr/bin/env bash

set -euo pipefail
umask 022

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_dir="$repo_dir/v2/home"

if [ ! -d "$source_dir" ]; then
  printf 'v2 chezmoi source not found: %s\n' "$source_dir" >&2
  exit 1
fi

if ! command -v chezmoi >/dev/null 2>&1; then
  bin_dir="$HOME/.local/bin"
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  mkdir -p "$bin_dir"
  curl -fsLS https://get.chezmoi.io -o "$installer"
  expected="75de125a45a82b53c16546db7057052e98c11866ded27c4b6f95a51f59432e7b"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$installer" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$installer" | awk '{print $1}')"
  fi
  [ "$actual" = "$expected" ] || { printf '%s\n' 'chezmoi installer checksum mismatch' >&2; exit 1; }
  sh "$installer" -b "$bin_dir" -t v2.72.0
  export PATH="$bin_dir:$PATH"
fi

exec chezmoi init --apply --force --source "$source_dir"
