# Source-only files.
.chezmoidata

# Authentication and mutable runtime state are never managed.
.config/gh
.config/gcloud
.config/opencode/auth.json
.docker/config.json
.local/share/opencode/auth.json
.zsh_history

# lazy.nvim rewrites this on every startup that resolves a plugin update, so
# managing it produces a conflict prompt on almost every apply. The pin is not
# worth keeping: plugins are allowed to float, so the lockfile records whatever
# the last nvim launch happened to see rather than an intended set of versions.
.config/nvim/lazy-lock.json

{{- if not (has .profile (list "desktop" "enterprise")) }}
# macOS-only configuration and applications.
.config/ghostty
.skhdrc
.config/skhd
.config/yabai
.config/brew
.local/bin/window-manager
{{- end }}

{{- if ne .profile "desktop" }}
# Personal desktop integrations are not deployed to restricted macOS.
.config/opencode/opencode-vm.env
Library
Documents/obsidian-vault
{{- end }}

{{- if ne .profile "desktop" }}
# Headless profiles do not carry the macOS-only Slack export workflow.
.local/bin/slackmd
.local/lib/dotfiles/format_slackdump_as_md.py
{{- end }}

{{- if ne .profile "server" }}
# The public HTTPS endpoint exists only on the VM.
.config/caddy
{{- end }}
