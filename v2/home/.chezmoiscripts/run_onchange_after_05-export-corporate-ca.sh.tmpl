#!/usr/bin/env bash

set -euo pipefail

# On the enterprise network a TLS-inspecting proxy re-signs outbound HTTPS with
# an internal root CA. macOS tools trust it because it is in the System
# keychain, but Node ships its own CA bundle and ignores the keychain entirely,
# so any Node process fetching over HTTPS fails with SELF_SIGNED_CERT_IN_CHAIN.
#
# This is separate from the npm registry setting: npm config only covers npm's
# own requests. Package postinstall scripts that download their own binaries
# (tree-sitter-cli fetches a release asset from github.com) use plain Node
# https and need NODE_EXTRA_CA_CERTS instead.
#
# Export the root from the System keychain rather than committing it. The cert
# is not secret, but it is machine-local trust state and the repository stays
# usable on machines that have never seen this CA.

{{- if and (eq .profile "enterprise") (eq .chezmoi.os "darwin") }}

ca_name={{ .tls.corporateRootCaCommonName | quote }}
ca_dir="$HOME/.config/ssl"
ca_file="$ca_dir/corporate-ca.pem"
bundle_file="$ca_dir/ca-bundle.pem"
system_roots="/System/Library/Keychains/SystemRootCertificates.keychain"

exported="$(security find-certificate -a -c "$ca_name" -p \
  /Library/Keychains/System.keychain 2>/dev/null || true)"

if [ -z "$exported" ]; then
  # Not fatal: a machine off the corporate network has nothing to trust, and
  # failing here would block the whole apply over an optional convenience.
  printf '%s\n' "corporate root CA '$ca_name' not found in the System keychain; skipping" >&2
  exit 0
fi

mkdir -p "$ca_dir"

# Two files because the consuming variables have opposite semantics.
#
# NODE_EXTRA_CA_CERTS *appends* to Node's built-in bundle, so it wants the
# corporate root on its own.
printf '%s\n' "$exported" > "$ca_file"
chmod 644 "$ca_file"

# SSL_CERT_FILE *replaces* the trust store outright. uv honours it, and pointing
# it at the corporate root alone makes uv distrust everything else: PyPI is not
# intercepted and serves a real GlobalSign chain, so installs fail with
# UnknownIssuer. Emit a complete bundle of the system roots plus the corporate
# root for anything that replaces rather than appends.
{
  security find-certificate -a -p "$system_roots" 2>/dev/null
  printf '%s\n' "$exported"
} > "$bundle_file"
chmod 644 "$bundle_file"
{{- else }}

exit 0
{{- end }}
