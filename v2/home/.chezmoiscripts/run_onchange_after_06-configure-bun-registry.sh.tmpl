#!/usr/bin/env bash

set -euo pipefail

# OpenCode installs its configured plugins with bun. Unlike npm, bun does not
# read ~/.npmrc, so on the enterprise network it ignores the Artifactory mirror
# and goes to registry.npmjs.org, which the proxy answers with 503. The plugin
# install then hangs OpenCode at startup rather than failing cleanly.
#
# Generate ~/.bunfig.toml from the npmrc that already exists on the machine.
# The token is read at apply time and never enters the repository: this file is
# derived local credential state, in the same category as ~/.npmrc itself.

{{- if eq .profile "enterprise" }}

npmrc="$HOME/.npmrc"
bunfig="$HOME/.bunfig.toml"

if [ ! -f "$npmrc" ]; then
  printf '%s\n' "no ~/.npmrc; skipping bun registry configuration" >&2
  exit 0
fi

registry="$(npm config get registry 2>/dev/null || true)"
case "$registry" in
  https://*) ;;
  *)
    printf '%s\n' "no usable npm registry resolved; skipping bun registry configuration" >&2
    exit 0
    ;;
esac

# Match the token for the configured registry rather than the first line, so an
# npmrc carrying several hosts cannot pair a token with the wrong one.
registry_host="${registry#https://}"
registry_host="${registry_host%%/*}"
token="$(sed -n "s|^//${registry_host}[^:]*:_authToken=||p" "$npmrc" | head -1)"

if [ -z "$token" ]; then
  printf '%s\n' "no auth token for $registry_host in ~/.npmrc; skipping bun registry configuration" >&2
  exit 0
fi

umask 077
cat > "$bunfig" <<EOF
# Generated by chezmoi from ~/.npmrc. Do not edit; do not commit.
[install]
registry = { url = "$registry", token = "$token" }
EOF
chmod 600 "$bunfig"
{{- else }}

exit 0
{{- end }}
