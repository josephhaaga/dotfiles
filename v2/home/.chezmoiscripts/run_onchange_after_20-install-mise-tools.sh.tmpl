#!/usr/bin/env bash

set -euo pipefail

# tool versions: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# package inventory: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

# azure-cli installs through the pipx backend, which runs uv. uv honours
# SSL_CERT_FILE and treats it as a replacement for the trust store, not an
# addition, so it needs the full bundle written by the 05 script. Without it
# uv rejects PyPI, which is not intercepted and serves a real public chain.
if [ -f "$HOME/.config/ssl/ca-bundle.pem" ]; then
  export SSL_CERT_FILE="$HOME/.config/ssl/ca-bundle.pem"
fi
if [ -f "$HOME/.config/ssl/corporate-ca.pem" ]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.config/ssl/corporate-ca.pem"
fi

if command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
elif [ -x "$HOME/.local/bin/mise" ]; then
  mise_bin="$HOME/.local/bin/mise"
else
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl -fsSL https://mise.run -o "$installer"
  expected="3731dfec59ffb0bc23df96ae19b4b51470db939c875c2fdf01cf6c25b1b1e039"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$installer" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$installer" | awk '{print $1}')"
  fi
  [ "$actual" = "$expected" ] || { printf '%s\n' 'mise installer checksum mismatch' >&2; exit 1; }
  MISE_VERSION=v2026.8.6 MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh "$installer"
  mise_bin="$HOME/.local/bin/mise"
fi

"$mise_bin" trust "$HOME/.config/mise"
"$mise_bin" install --yes
