#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# Node ignores the macOS keychain and uses its own CA bundle, so behind a
# TLS-inspecting proxy every Node HTTPS request fails with
# SELF_SIGNED_CERT_IN_CHAIN. Setting the registry below is not enough: it only
# covers npm's own traffic, while package postinstall scripts fetch their own
# binaries directly (tree-sitter-cli pulls a release asset from github.com).
# The 05 script exports this bundle when the machine has the CA installed.
corporate_ca="$HOME/.config/ssl/corporate-ca.pem"
if [ -f "$corporate_ca" ]; then
  export NODE_EXTRA_CA_CERTS="$corporate_ca"
fi

npm_packages=(
{{- range $package, $version := .packages.npm }}
{{- if and (or (ne $.profile "server") (ne $package "tree-sitter-cli")) (or (eq $.profile "enterprise") (ne $package "@plannotator/opencode")) }}
  {{ printf "%s@%s" $package $version | quote }}
{{- end }}
{{- end }}
{{- if eq .profile "server" }}
{{- range $package, $version := .packages.npm_server }}
  {{ printf "%s@%s" $package $version | quote }}
{{- end }}
{{- end }}
)

# --prefix relocates the global npmrc npm reads to "$HOME/.local/etc/npmrc",
# which does not exist, so a registry set in the Node install's global npmrc is
# silently dropped and npm falls back to registry.npmjs.org. On networks with a
# private mirror and a TLS-inspecting proxy that fallback fails with
# SELF_SIGNED_CERT_IN_CHAIN. Resolve the registry before --prefix takes effect
# and pass it explicitly.
npm_registry="$(npm config get registry)"

# V2 replaces the legacy CLI and beta preview. npm does not remove packages
# omitted from a later install, and both old packages own the `opencode2` bin.
# Remove them before installing V2 so npm can install its compatibility shim.
npm uninstall --global --prefix "$HOME/.local" \
  @opencode-ai/cli opencode-ai

npm install --global --prefix "$HOME/.local" \
  --registry "$npm_registry" \
  --allow-scripts=@opencode/cli,node-pty \
  --ignore-scripts=false "${npm_packages[@]}"

plannotator_version="0.27.17"
# Commit behind the v0.27.17 installer. Pinning its object ID makes the script
# URL immutable; the SHA-256 below verifies its bytes before execution.
plannotator_installer_commit="8f2a8a81a384f1cd39c5f083d3c6fcd35a956422"
installer="$(mktemp)"
trap 'rm -f "$installer"' EXIT

verify_installer() {
  local expected="$1"
  local actual
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$installer" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$installer" | awk '{print $1}')"
  fi
  [ "$actual" = "$expected" ]
}

curl -fsSL "https://raw.githubusercontent.com/backnotprop/plannotator/${plannotator_installer_commit}/scripts/install.sh" -o "$installer"
verify_installer "df4170473178791deed11849f01c84d9e791263d9064de812e1dfc880aee5e96" || {
  printf '%s\n' 'Plannotator installer checksum mismatch' >&2
  exit 1
}
# The vendor installer has no Pi opt-out and updates Pi whenever it is on PATH.
PATH="$HOME/.local/share/mise/shims:/usr/bin:/bin:/usr/sbin:/sbin" \
  bash "$installer" --version "$plannotator_version" --non-interactive \
  --skip-skills --skip-codex --skip-gemini --skip-kiro --skip-opencode
