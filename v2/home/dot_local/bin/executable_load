#!/usr/bin/env bash
set -euo pipefail

source_dir="$(chezmoi source-path)"
dotfiles_repo="$(cd "$source_dir/../.." && pwd)"
repos=("$HOME/Documents/journal" "$dotfiles_repo")
exit_code=0

for repo in "${repos[@]}"; do
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'Skipping %s: not a Git repository.\n' "$repo" >&2
    exit_code=1
    continue
  fi

  if ! git -C "$repo" fetch origin; then
    printf 'Failed to fetch %s.\n' "$repo" >&2
    exit_code=1
    continue
  fi

  if ! upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then
    printf 'Skipping %s: current branch has no upstream.\n' "$repo" >&2
    exit_code=1
    continue
  fi

  local_commit="$(git -C "$repo" rev-parse HEAD)"
  remote_commit="$(git -C "$repo" rev-parse "$upstream")"
  base_commit="$(git -C "$repo" merge-base HEAD "$upstream")"

  if [ "$local_commit" = "$remote_commit" ] || [ "$remote_commit" = "$base_commit" ]; then
    printf '%s: no updates to pull.\n' "$repo"
  elif [ "$local_commit" = "$base_commit" ]; then
    git -C "$repo" pull --ff-only
    printf '%s: pulled latest changes.\n' "$repo"
  else
    printf '%s: diverged from %s; resolve it before loading.\n' "$repo" "$upstream" >&2
    exit_code=1
  fi
done

exit "$exit_code"
