#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: save' >&2
  exit 2
fi

source_dir="$(chezmoi source-path)"
dotfiles_repo="$(cd "$source_dir/../.." && pwd)"
repos=("$HOME/Documents/journal" "$dotfiles_repo")
exit_code=0

git_bin="$(command -v git || true)"
if [ -z "$git_bin" ] && [ -x /opt/homebrew/bin/git ]; then
  git_bin=/opt/homebrew/bin/git
fi
if [ -z "$git_bin" ]; then
  printf '%s\n' 'Git is required for save.' >&2
  exit 1
fi

for repo in "${repos[@]}"; do
  if ! "$git_bin" -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'Skipping %s: not a Git repository.\n' "$repo" >&2
    exit_code=1
    continue
  fi

  if [ -z "$("$git_bin" -C "$repo" status --porcelain)" ]; then
    printf '%s: no changes to save.\n' "$repo"
    continue
  fi

  printf '%s:\n' "$repo"
  "$git_bin" -C "$repo" diff --stat HEAD || true
  "$git_bin" -C "$repo" add --all
  "$git_bin" -C "$repo" commit -m "Autosave at $(date)"
  "$git_bin" -C "$repo" push
done

exit "$exit_code"
